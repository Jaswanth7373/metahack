# Meta Model API key (https://dev.meta.ai). Leave empty to run in Demo Mode.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1

# Model IDs (verified against dev.meta.ai/docs/models on 2026-10-29)
SPARK_MODEL=muse-spark-1.3
WONDER_MODEL=muse-wonder-1.0
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0

# Hard spending cap across all paid calls (USD), and per-task cap
BUDGET_CAP_USD=100
TASK_COST_CAP_USD=0.50
MAX_AGENT_STEPS=10

# true = replay cached responses (no network). Unset = auto (on when MODEL_API_KEY is empty).
DEMO_MODE=true
# true = in real mode, write every response into backend/demo_cache for later replay
RECORD_DEMO_CACHE=false

# Privacy engine: rules (no GPU needed) | local (Muse Glimmer via a local OpenAI-compatible server)
GLIMMER_MODE=rules
GLIMMER_BASE_URL=http://localhost:11434/v1
GLIMMER_MODEL=muse-glimmer
